# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and adjust variables as required.
# ==============================================================================

# Database Connection
# For local development with SQLite (default):
DATABASE_URL=sqlite:///data/ecommerce_analytics.db

# For PostgreSQL (e.g., Docker, local PostgreSQL instance, or GitHub Actions CI):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ecommerce_db

# Application Paths
RAW_DATA_PATH=data/raw/online_retail.csv
REJECTED_RECORDS_PATH=data/processed/rejected_records.csv
PROCESSED_DATA_PATH=data/processed/clean_retail_transactions.csv
REPORTS_DIR=reports

# Logging & Execution
LOG_LEVEL=INFO
APP_ENV=development
